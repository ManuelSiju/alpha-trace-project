# Ollama (local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=2000

# Free-tier optional keys (leave blank to skip)
SHODAN_API_KEY=
HAVEIBEENPWNED_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=alpha-tracer/0.1

# Proxy (optional)
USE_PROXIES=false

# Rate limiting
MAX_REQUESTS_PER_MINUTE=30
MAX_CONCURRENT_REQUESTS=5

# Logging
LOG_LEVEL=INFO

# Privacy
MASK_SENSITIVE_DATA=true
