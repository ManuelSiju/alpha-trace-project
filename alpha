#!/usr/bin/env bash
# Alpha-Tracer launcher (Linux/macOS). Provisions everything via uv, then runs the app.
# No sudo/admin required anywhere in this script.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

UV_MANUAL_INSTALL='curl -LsSf https://astral.sh/uv/install.sh | sh'

if ! command -v uv >/dev/null 2>&1; then
    echo "uv (Python packaging tool) not found — installing it for your user account only..."
    if ! command -v curl >/dev/null 2>&1; then
        echo "curl is required to install uv automatically, and was not found on this system."
        echo "Install uv manually for your OS, then re-run ./alpha:"
        echo "  $UV_MANUAL_INSTALL"
        echo "  (see https://docs.astral.sh/uv/getting-started/installation/ for other options)"
        exit 1
    fi
    if ! curl -LsSf https://astral.sh/uv/install.sh | sh; then
        echo "Could not install uv automatically."
        echo "Install it manually, then re-run ./alpha:"
        echo "  $UV_MANUAL_INSTALL"
        exit 1
    fi
    export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
    if ! command -v uv >/dev/null 2>&1; then
        echo "uv was installed but isn't on PATH in this shell."
        echo "Open a new terminal (so your shell picks up the updated PATH) and re-run ./alpha."
        exit 1
    fi
fi

if [ ! -d ".venv" ]; then
    echo "Creating virtual environment (.venv) with Python 3.11 via uv..."
    uv venv --python 3.11 .venv
fi

echo "Installing dependencies..."
uv pip install --python .venv/bin/python -r requirements.txt

MARKER=".venv/.playwright_installed"
if [ ! -f "$MARKER" ]; then
    echo "Installing Playwright's Chromium (one-time, optional — used only for LinkedIn scraping)..."
    if .venv/bin/python -m playwright install chromium; then
        touch "$MARKER"
    else
        echo "Warning: Playwright Chromium install failed or was skipped. Alpha-Tracer will still run;"
        echo "this only affects the optional LinkedIn-scraping path."
    fi
fi

if ! command -v ollama >/dev/null 2>&1; then
    echo "Ollama not found — installing it..."
    case "$(uname -s)" in
        Darwin)
            if command -v brew >/dev/null 2>&1; then
                brew install ollama
            else
                curl -fsSL https://ollama.com/install.sh | sh
            fi
            ;;
        Linux)
            curl -fsSL https://ollama.com/install.sh | sh
            ;;
        *)
            echo "Don't know how to auto-install Ollama on this OS."
            echo "Install it manually: https://ollama.com/download"
            ;;
    esac
    export PATH="$HOME/.local/bin:$PATH"
fi

if command -v ollama >/dev/null 2>&1; then
    if ! curl -fsS -o /dev/null --max-time 2 http://localhost:11434/api/tags 2>/dev/null; then
        echo "Starting Ollama daemon..."
        nohup ollama serve >/tmp/alpha-tracer-ollama.log 2>&1 &
        disown
        for _ in $(seq 1 30); do
            curl -fsS -o /dev/null --max-time 1 http://localhost:11434/api/tags 2>/dev/null && break
            sleep 1
        done
    fi

    MODEL="$(.venv/bin/python -c 'from config.settings import settings; print(settings.OLLAMA_MODEL)' 2>/dev/null || echo qwen2.5:7b-instruct)"
    FALLBACK="$(.venv/bin/python -c 'from config.settings import settings; print(settings.OLLAMA_FALLBACK_MODEL)' 2>/dev/null || echo qwen2.5:3b-instruct)"
    if command -v ollama >/dev/null 2>&1 && ! ollama list 2>/dev/null | awk '{print $1}' | grep -qx "$MODEL"; then
        echo "Pulling model $MODEL (first run, ~5 GB)..."
        if ! ollama pull "$MODEL"; then
            echo "Primary model pull failed (likely low RAM/disk) — falling back to $FALLBACK..."
            if ! ollama list 2>/dev/null | awk '{print $1}' | grep -qx "$FALLBACK"; then
                ollama pull "$FALLBACK" || echo "Warning: fallback pull failed too; Alpha-Tracer will use a deterministic briefing until a model is available."
            fi
        fi
    fi
else
    echo "Ollama still not available — Alpha-Tracer will run with a deterministic fallback briefing."
fi

exec .venv/bin/python main.py "$@"
